# Node (kept in case this project ever grows a JS piece)
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
venv/
.venv/

# App data - the whole point is that this stays local and per-machine
# (lives in src/, one folder under the app's own code - see AGENTS.md)
src/data/*.db
src/data/*.db-journal
backups/
src/logs/*.log

# Env / secrets
.env
.env.*

# OS / editor
.vscode/
.DS_Store
Thumbs.db

# Output
*.log

# PyInstaller build artifacts (see build_exe.bat) - regenerate, don't commit
build/
dist/
*.spec.bak
